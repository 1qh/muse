#!/bin/sh
# Lint, types and the whole suite refuse a push; the source checks join when MUSE_SOURCES and MUSE_PINS name the private inputs.
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
.venv/bin/ruff check src tests </dev/null
.venv/bin/mypy src </dev/null
if [ -n "${MUSE_SOURCES:-}" ] && [ -n "${MUSE_PINS:-}" ]; then
  .venv/bin/python -m pytest -q -p no:cacheprovider </dev/null
else
  .venv/bin/python -m pytest -q -p no:cacheprovider --ignore=tests/test_sources.py </dev/null  # only the source checks need the private inputs
fi
